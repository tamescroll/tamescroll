<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<!-- Merged into the generated iOS Info.plist by `tauri ios init/build` (#16). -->
<plist version="1.0">
<dict>
	<!-- Only standard HTTPS, so TestFlight and the App Store do not stop
	     each build to ask about encryption export rules. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Sites can ask for these (voice search, video calls, "near me"
	     results, a photo upload). WebKit asks the person first, and the
	     app itself never uses them; without these strings such a request
	     would close the app. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A site you open can ask to use the microphone, for example for voice search. You decide each time.</string>
	<key>NSCameraUsageDescription</key>
	<string>A site you open can ask to use the camera, for example to take a photo to upload. You decide each time.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>A site you open can ask for your location, for example to show results near you. You decide each time.</string>
	<!-- tamescroll://open/<platform>[?url=<link>]: how links, the
	     Shortcuts app and the quick actions below reach the launcher
	     (launcher_query_for_open in lib.rs). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.tamescroll.client</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tamescroll</string>
			</array>
		</dict>
	</array>
	<!-- Long-press on the app icon. Plain titles, no platform logos (#24).
	     The type after "open." is the platform id. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>open.youtube</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>YouTube</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>open.reddit</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Reddit</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>open.x</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>X</string>
		</dict>
	</array>
</dict>
</plist>
